# Copy to .env (in the project root) and fill in. .env is git-ignored.

# Required: embeddings and answers (needs text-embedding-3-small and gpt-5-mini
# enabled on the OpenAI project; the evals also use gpt-5 as the judge).
OPENAI_API_KEY=

# Optional: Chroma database location (default: <project root>/.chroma).
# CHROMA_DIR=
